{
  "name": "Lab DevSecOps IPOG - TSC31262R",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "HashiCorp.terraform",
        "mhutchie.git-graph",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "git --version && terraform --version && docker --version && echo '✅ Ambiente DevSecOps IPOG pronto para uso!'",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "OWASP Juice Shop (lab Aula 03)"
    }
  }
}
